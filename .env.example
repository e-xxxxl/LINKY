# Postgres (Supabase).
# - Local / running migrations: Session pooler, port 5432.
# - Vercel runtime: Transaction pooler, port 6543, with ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Admin area at /admin (required to sign in). Use long, unique values in production.
ADMIN_PASSWORD=""
SESSION_SECRET=""

# Reputation providers (optional). Leave blank to show "Not available".
GOOGLE_SAFE_BROWSING_API_KEY=""
VIRUSTOTAL_API_KEY=""

# Burst guard (in-memory, per instance)
RATE_LIMIT_MAX="20"
RATE_LIMIT_WINDOW_MS="60000"

# Free scans per visitor per hour (stored in the RateHit table)
SCAN_LIMIT_PER_HOUR="5"

# Public origin, used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL="https://linky.tekuvo.com.ng"
