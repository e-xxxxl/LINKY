// LINKY data model. Postgres (Supabase).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scan {
  id            String   @id @default(cuid())
  sessionId     String
  originalUrl   String
  normalizedUrl String
  host          String
  riskLevel     String
  riskScore     Int
  summary       String
  reasons       String // JSON string array
  signals       String // JSON ScanSignal[]
  redirectChain String // JSON RedirectHop[]
  domain        String // JSON DomainInfo
  reputation    String // JSON ReputationResult[]
  createdAt     DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(cuid())
  name       String
  avatarSeed String?  @map("avatarUrl") // seed for the generated bubblehead avatar
  rating     Int
  reviewText String
  reason     String?
  status     String   @default("pending") // pending | approved | rejected
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([status])
}

// One row per scan request, keyed by a salted hash of the visitor's IP.
// Used to enforce the hourly scan quota across all serverless instances.
model RateHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
